<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Upload Question Photo - Mr. Harony</title>
<meta name="viewport" content="width=device-width, initial-scale=1">

<style>
/* ===== Colors ===== */
:root {
  --bg: #f5f7ff;
  --card: #ffffff;
  --text: #111;
  --muted: #666;
  --primary: #4f6df5;
  --answer-bg: #f4f6ff;
  --border: #1a2b4c;
}

body.dark {
  --bg: #0f1220;
  --card: #2b2e38;
  --text: #f1f1f1;
  --muted: #aaa;
  --primary: #6a82ff;
  --answer-bg: #1f2550;
  --border: #ffffff;
}

* { box-sizing: border-box; }

body {
  margin: 0;
  min-height: 100vh;
  padding: 20px;
  background: radial-gradient(circle at top, var(--bg), #e6ebf5);
  font-family: "Segoe UI", Arial, sans-serif;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--text);
}

.card {
  width: min(500px, 100%);
  padding: 28px;
  background: var(--card);
  border-radius: 18px;
  border: 1px solid var(--border);
  box-shadow: 0 20px 40px rgba(0,0,0,0.12);
  text-align: center;
}

h2 {
  margin-top: 0;
  margin-bottom: 8px;
  font-size: 22px;
}

p {
  color: var(--muted);
  font-size: 14px;
  margin-bottom: 24px;
}

/* إخفاء حقل الإدخال الأصلي */
#cameraInput {
  display: none;
}

/* زر مخصص لتشغيل الكاميرا */
.camera-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  width: 100%;
  padding: 16px;
  background: linear-gradient(135deg, #4f6df5, #6a82ff);
  color: #fff;
  font-size: 17px;
  font-weight: bold;
  border-radius: 12px;
  border: 1px solid var(--border);
  cursor: pointer;
  transition: transform 0.1s ease;
}

.camera-btn:active {
  transform: scale(0.98);
}

/* صندوق معاينة الصورة */
.preview-container {
  margin-top: 20px;
  display: none;
}

.preview-container img {
  width: 100%;
  max-height: 320px;
  object-fit: contain;
  border-radius: 10px;
  border: 1px solid var(--border);
  background: #000;
}

.status-msg {
  margin-top: 15px;
  font-size: 14px;
  font-weight: bold;
}
</style>
</head>

<body>

<div class="card">
  <h2>Ask Mr. Harony</h2>
  <p>Take a clear photo of your question or worksheet</p>

  <!-- عنصر الإدخال الذي يشغل كاميرا الموبايل -->
  <input 
    type="file" 
    id="cameraInput" 
    accept="image/*" 
    capture="environment"
  >

  <!-- الزر الظاهر للطالب -->
  <label for="cameraInput" class="camera-btn">
    📷 Take a Photo
  </label>

  <!-- مساحة ظهور الصورة بعد التقاطها -->
  <div class="preview-container" id="previewContainer">
    <img id="imagePreview" alt="Captured Question">
    <div class="status-msg" id="statusMsg">✅ Photo captured successfully</div>
  </div>
</div>

<script>
const cameraInput = document.getElementById("cameraInput");
const previewContainer = document.getElementById("previewContainer");
const imagePreview = document.getElementById("imagePreview");

cameraInput.addEventListener("change", function(event) {
  const file = event.target.files[0];
  if (file) {
    const reader = new FileReader();
    reader.onload = function(e) {
      imagePreview.src = e.target.result;
      previewContainer.style.display = "block";
    };
    reader.readAsDataURL(file);
  }
});
</script>

</body>
</html>
